{
	"name": "results",
	"private": true,
	"version": "0.0.1",
	"description": "The results site for this year's Stack Overflow Developer Survey.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run archive",
		"archive": "for d in ../archive/[0-9][0-9][0-9][0-9]; do [ -d \"$d/site\" ] && cp -Rl \"$d/site\" \"build/${d##*/}\"; done; cp -Rl ../archive/legacy-assets build/legacy-assets",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.4.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.6.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@stackoverflow/stacks-icons": "^7.0.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0"
	}
}
