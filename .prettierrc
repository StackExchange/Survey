{
	"semi": false,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "es5",
	"printWidth": 140,
	"plugins": ["prettier-plugin-svelte", "@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"",
		"<THIRD_PARTY_MODULES>",
		"",
		"^\\$(app|env)/",
		"^\\$(config|generated|archive|questions|content|data|charts|lib)",
		"",
		"^[.]",
		"",
		"<TYPES>"
	],
	"importOrderTypeScriptVersion": "5.0.0",
	"importOrderCaseSensitive": false,
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": "packages/results/**",
			"options": {
				"tailwindStylesheet": "./packages/results/src/routes/layout.css"
			}
		}
	]
}
